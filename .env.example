# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_THINKING_LEVEL="HIGH"
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite"

# SESSION_SECRET: Strong random secret for signing local JWT session tokens.
SESSION_SECRET="change-this-to-a-long-random-secret"

# SUPABASE: Required when migrating persistence & auth to Supabase PostgreSQL.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
